    { "route": "/playwright.config.js", "statusCode": 404 },
    { "route": "/playwright-report", "statusCode": 404 },
    { "route": "/playwright-report/*", "statusCode": 404 },
    { "route": "/test-results", "statusCode": 404 },
    { "route": "/test-results/*", "statusCode": 404 },
